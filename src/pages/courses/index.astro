---
import CourseHeader from "../../components/courses/CourseHeader.astro";
import CourseCard from "../../components/courses/CourseCard.astro";

const courses = [
    {
        title: "Introduction to Statistics",
        description:
            "Master data analysis, probability, and statistical inference from scratch.",
        href: `${import.meta.env.BASE_URL}courses/stats`,
        icon: "📊",
        color: "blue",
    },
    {
        title: "Advanced Mathematics",
        description:
            "Deep dive into calculus, linear algebra, and discrete math for engineering.",
        href: `${import.meta.env.BASE_URL}courses/maths`,
        icon: "/images/courses/maths_icon_3d_new_1771645124467.png",
        color: "purple",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}favicon.svg`}
        />
        <meta name="generator" content={Astro.generator} />
        <title>Courses – Kinetix Learning</title>

        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();
            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="font-sans antialiased text-slate-900 bg-white dark:bg-[#131314] dark:text-neutral-50 min-h-screen flex flex-col"
    >
        <CourseHeader />

        <main class="flex-1 pb-24">
            <!-- Hero Section -->
            <section class="px-6 py-6 md:py-8">
                <div class="container mx-auto max-w-6xl">
                    <div
                        class="relative overflow-hidden rounded-[14px] bg-gradient-to-br from-[#1e1e1f] to-[#131314] border border-white/5 p-6 md:p-8"
                    >
                        <!-- Background Glow Effects -->
                        <div
                            class="absolute -top-24 -left-24 w-96 h-96 bg-blue-500/10 blur-[100px] rounded-full"
                        >
                        </div>
                        <div
                            class="absolute -bottom-24 -right-24 w-96 h-96 bg-purple-500/10 blur-[100px] rounded-full"
                        >
                        </div>

                        <div class="relative z-10 max-w-2xl">
                            <!-- <div class="flex items-center gap-3 mb-3">
                                <div
                                    class="px-2.5 py-0.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-[9px] font-bold uppercase tracking-widest"
                                >
                                    Feature
                                </div>
                                <span
                                    class="text-neutral-500 text-xs font-medium"
                                    >Academic Modules</span
                                >
                            </div> -->

                            <h1
                                class="text-2xl md:text-3xl lg:text-4xl font-bold text-white mb-3 tracking-tight leading-tight font-display whitespace-nowrap"
                            >
                                Build your skills,
                                <span
                                    class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent"
                                    >a new kind of way</span
                                >
                            </h1>

                            <p
                                class="text-sm text-neutral-400 mb-0 leading-relaxed max-w-md"
                            >
                                Master complex subjects with structured learning
                                paths and interactive visualizations.
                            </p>
                        </div>

                        <!-- Floating Visual Element (Optional) -->
                        <div
                            class="absolute right-8 bottom-8 hidden lg:block select-none opacity-10"
                        >
                            <div
                                class="text-[120px] font-bold text-white/10 leading-none rotate-12"
                            >
                                ⚛️
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Course Grid Section -->
            <section class="px-6 py-6">
                <div class="container mx-auto max-w-6xl">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-xl font-bold text-white font-display">
                            Available Courses <span
                                class="text-neutral-600 ml-2 font-normal text-base"
                                >{courses.length}</span
                            >
                        </h2>
                        <button
                            class="text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1 group"
                        >
                            Show more
                            <svg
                                class="w-4 h-4 transition-transform group-hover:translate-y-0.5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </button>
                    </div>

                    <div class="grid grid-cols-2 lg:flex lg:gap-6 gap-3 mb-8">
                        {
                            courses.map((course) => (
                                <div class="w-full lg:w-64 flex-shrink-0">
                                    <CourseCard {...course} />
                                </div>
                            ))
                        }

                        <!-- Placeholder/Coming Soon Card -->
                        <div
                            class="w-full lg:w-64 flex-shrink-0 aspect-square rounded-[24px] border-2 border-dashed border-white/5 flex flex-col items-center justify-center p-4 sm:p-8 text-center group cursor-pointer hover:border-white/10 transition-colors"
                        >
                            <div
                                class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white/5 flex items-center justify-center text-lg sm:text-xl mb-2 sm:mb-4 group-hover:scale-110 transition-transform"
                            >
                                🧪
                            </div>
                            <h3
                                class="text-neutral-400 font-bold text-[10px] sm:text-sm mb-0.5 sm:mb-1"
                            >
                                New Modules
                            </h3>
                            <p
                                class="text-neutral-600 text-[8px] sm:text-[10px] text-balance"
                            >
                                Adding more soon.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </body>
</html>

<style>
    .font-display {
        font-family: "Outfit", sans-serif;
    }
</style>
