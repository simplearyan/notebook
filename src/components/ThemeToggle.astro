---
import { Sun, Moon } from "lucide-react";
---

<button
    class="theme-toggle relative p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-200 dark:focus:ring-slate-700 group"
    aria-label="Toggle Theme"
>
    <!-- Sun Icon: Visible in Dark, Hidden in Light (Rotates in) -->
    <Sun
        className="absolute inset-2 w-5 h-5 transition-all duration-300 transform rotate-90 scale-0 dark:rotate-0 dark:scale-100 text-yellow-500"
    />

    <!-- Moon Icon: Visible in Light, Hidden in Dark (Rotates out) -->
    <Moon
        className="w-5 h-5 transition-all duration-300 transform rotate-0 scale-100 dark:-rotate-90 dark:scale-0 text-slate-700"
    />
</button>

<script>
    const setupToggles = () => {
        const themeToggleBtns = document.querySelectorAll(".theme-toggle");

        const getTheme = () => {
            if (
                typeof localStorage !== "undefined" &&
                localStorage.getItem("theme")
            ) {
                return localStorage.getItem("theme");
            }
            if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                return "dark";
            }
            return "light";
        };

        const setTheme = (theme: "light" | "dark") => {
            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);
        };

        themeToggleBtns.forEach((btn) => {
            // Remove old listener if any (though Astro scripts usually run once)
            btn.addEventListener("click", () => {
                const currentTheme = getTheme();
                const newTheme = currentTheme === "light" ? "dark" : "light";
                setTheme(newTheme);
            });
        });
    };

    setupToggles();
    // Re-run on view transitions if using them
    document.addEventListener("astro:after-swap", setupToggles);
</script>
