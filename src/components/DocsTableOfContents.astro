---
interface Props {
    headings: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;

// Filter out H1 (title) and perhaps keep only H2/H3 for simplicity
const filteredHeadings = headings.filter(
    (h: any) => h.depth > 1 && h.depth <= 3,
);
---

{
    filteredHeadings.length > 0 && (
        <nav class="toc hidden xl:block w-64 shrink-0 sticky top-[57px] h-[calc(100vh-57px)] overflow-y-auto py-10 pl-8 pr-4">
            <h5 class="text-sm font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4">
                On this page
            </h5>
            <ul class="space-y-3 text-sm">
                {filteredHeadings.map((heading) => (
                    <li class={`${heading.depth === 3 ? "pl-4" : ""}`}>
                        <a
                            href={`#${heading.slug}`}
                            class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200 transition-colors duration-200 line-clamp-2"
                        >
                            {heading.text}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    )
}

<style>
    .toc {
        /* Hide scrollbar for cleaner look but allow scroll */
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .toc::-webkit-scrollbar {
        display: none;
    }
</style>
