---
import { getCollection } from "astro:content";
import SmartSidebar from "./SmartSidebar";

const { currentSlug } = Astro.props;
const docs = await getCollection("docs");

type NavNode = {
    name: string;
    path: string;
    children: NavNode[];
    doc: any | null;
    order: number;
    title: string;
};

// Improved Tree Building Logic
const groupDocs = (docs: any[]): NavNode[] => {
    // Map slugs to items
    const items = docs
        .map((doc) => ({
            slug: doc.slug,
            title: doc.data.title,
            order: doc.data.order,
            ...doc,
        }))
        .sort((a, b) => a.order - b.order);

    const tree: NavNode[] = [];
    const lookup: Record<string, NavNode> = {};

    items.forEach((doc) => {
        const parts = doc.slug.split("/");

        let path = "";
        let parent = tree;

        for (let i = 0; i < parts.length; i++) {
            const part = parts[i];

            // If part is 'index', it assigns the doc to the current path's folder
            if (part === "index") {
                continue;
            }

            path = path ? `${path}/${part}` : part;

            // Check if we have a node for this path
            let node = lookup[path];

            if (!node) {
                node = {
                    name: part,
                    path: path,
                    children: [],
                    doc: null,
                    order: 999,
                    title:
                        part.charAt(0).toUpperCase() +
                        part.slice(1).replace(/-/g, " "), // Fallback title
                };
                parent.push(node);
                lookup[path] = node;
            }

            // If this is the last part of this doc's slug (ignoring 'index'), assign the doc
            if (
                i === parts.length - 1 ||
                (i === parts.length - 2 && parts[i + 1] === "index")
            ) {
                node.doc = doc;
                node.title = doc.data.title;
                node.order = doc.data.order;
            }

            parent = node.children;
        }
    });

    // Recursive sort
    const sortTree = (nodes: NavNode[]) => {
        nodes.sort((a, b) => a.order - b.order);
        nodes.forEach((n) => sortTree(n.children));
    };
    sortTree(tree);

    return tree;
};

const navTree = groupDocs(docs);
---

<SmartSidebar
    client:load
    menu={navTree}
    currentSlug={currentSlug || ""}
    baseUrl={import.meta.env.BASE_URL}
/>
