---
import { Menu, X, Github } from "lucide-react";
import ThemeToggle from "./ThemeToggle.astro";
import FontSettings from "./FontSettings";
import Search from "./Search";
import PencilRocketLogo from "./PencilRocketLogo.astro";

const links = [
    {
        label: "GitHub",
        href: "https://github.com/simplearyan/notebook",
        external: true,
    },
];
---

<header
    class="sticky top-0 z-40 w-full flex-none transition-colors duration-500 lg:z-50 border-b border-slate-900/10 dark:border-slate-50/[0.06] bg-white dark:bg-neutral-950"
>
    <div class="max-w-8xl mx-auto">
        <div class="py-2.5 lg:px-8 dark:border-slate-300/10 px-4">
            <div class="relative flex items-center">
                {/* Logo Section */}
                <div class="flex items-center lg:w-64">
                    <button
                        type="button"
                        id="docs-menu-btn-header"
                        class="lg:hidden text-slate-500 hover:text-slate-600 dark:text-slate-400 dark:hover:text-slate-300 mr-4"
                    >
                        <span class="sr-only">Navigation</span>
                        <Menu className="w-5 h-5" />
                    </button>

                    <a
                        class="mr-3 flex-none overflow-hidden md:w-auto text-slate-900 dark:text-white font-bold text-lg tracking-tight flex items-center gap-2"
                        href={`${import.meta.env.BASE_URL}`}
                    >
                        <div
                            class="w-7 h-7 bg-slate-100 dark:bg-neutral-900 rounded-lg flex items-center justify-center border border-slate-200 dark:border-slate-800"
                        >
                            <PencilRocketLogo size={20} />
                        </div>
                        <span class="hidden sm:inline">Kinetix</span>
                        <span
                            class="text-slate-400 dark:text-slate-500 font-normal px-1 text-sm bg-slate-100 dark:bg-slate-800 rounded-full border border-slate-200 dark:border-slate-700"
                            >docs</span
                        >
                    </a>
                </div>

                {/* Center Section: Search */}
                <div class="flex-1 flex justify-center px-4">
                    <Search client:load />
                </div>

                {/* Right Section: Links & Actions */}
                <div class="relative flex items-center justify-end lg:w-64">
                    <nav
                        class="text-sm leading-6 font-medium text-slate-700 dark:text-slate-200 hidden md:block"
                    >
                        <ul class="flex space-x-6">
                            {
                                links.map((link) => (
                                    <li>
                                        <a
                                            href={link.href}
                                            target={
                                                link.external
                                                    ? "_blank"
                                                    : undefined
                                            }
                                            class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 transition-colors"
                                            title={link.label}
                                        >
                                            <Github className="w-5 h-5" />
                                            <span class="sr-only">
                                                {link.label}
                                            </span>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </nav>
                    <div
                        class="flex items-center gap-4 border-l border-slate-200 ml-6 pl-6 dark:border-slate-800"
                    >
                        <div class="hidden lg:block">
                            <FontSettings client:load />
                        </div>
                        <ThemeToggle />
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
