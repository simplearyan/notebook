---
import { getCollection } from "astro:content";
const { currentSlug } = Astro.props;

const docs = await getCollection("docs");
// Filter out docs that shouldn't be in the main flow if needed, or just sort all
const sortedDocs = docs
    .filter((doc) => doc.data.order !== undefined) // Only include docs with an explicit order
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = sortedDocs.findIndex((doc) => doc.slug === currentSlug);
const prev = currentIndex > 0 ? sortedDocs[currentIndex - 1] : null;
const next =
    currentIndex > -1 && currentIndex < sortedDocs.length - 1
        ? sortedDocs[currentIndex + 1]
        : null;

const baseUrl = import.meta.env.BASE_URL;
const stripEndingSlash = (url: string) =>
    url.endsWith("/") ? url.slice(0, -1) : url;
const cleanBaseUrl = stripEndingSlash(baseUrl);

const getUrl = (slug: string) => {
    const s = slug === "index" ? "" : slug;
    return `${cleanBaseUrl}/docs/${s}`;
};
---

<div
    class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-stretch justify-between gap-4"
>
    {
        prev ? (
            <a
                href={getUrl(prev.slug)}
                class="group flex-1 p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-blue-500/50 dark:hover:border-blue-400/50 transition-all bg-white dark:bg-neutral-950 shadow-sm hover:shadow-md flex flex-col items-start"
            >
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-1 mb-1">
                    &larr; Previous Item
                </span>
                <span class="text-base font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {prev.data.title}
                </span>
            </a>
        ) : (
            <div class="flex-1 hidden sm:block" />
        )
    }

    {
        next ? (
            <a
                href={getUrl(next.slug)}
                class="group flex-1 p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-blue-500/50 dark:hover:border-blue-400/50 transition-all bg-white dark:bg-neutral-950 shadow-sm hover:shadow-md flex flex-col items-end text-right"
            >
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider flex items-center gap-1 mb-1">
                    Next Item &rarr;
                </span>
                <span class="text-base font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {next.data.title}
                </span>
            </a>
        ) : (
            <div class="flex-1 hidden sm:block" />
        )
    }
</div>
