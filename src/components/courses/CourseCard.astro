---
interface Props {
    title: string;
    description: string;
    href: string;
    icon?: string;
    color?: string;
}

const { title, description, href, icon = "📊", color = "blue" } = Astro.props;

const colorVariants = {
    blue: "bg-blue-50 text-blue-600 border-blue-100 group-hover:border-blue-200 group-hover:bg-blue-100/50",
    purple: "bg-purple-50 text-purple-600 border-purple-100 group-hover:border-purple-200 group-hover:bg-purple-100/50",
    green: "bg-green-50 text-green-600 border-green-100 group-hover:border-green-200 group-hover:bg-green-100/50",
    orange: "bg-orange-50 text-orange-600 border-orange-100 group-hover:border-orange-200 group-hover:bg-orange-100/50",
};

const bgColor = colorVariants[color as keyof typeof colorVariants] || colorVariants.blue;
---

<a href={href} class="group block p-6 bg-white dark:bg-neutral-900 rounded-2xl border border-slate-200 dark:border-neutral-800 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300">
    <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-2xl mb-6 transition-colors ${bgColor}`}>
        {icon}
    </div>
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        {title}
    </h3>
    <p class="text-slate-600 dark:text-neutral-400 text-sm leading-relaxed">
        {description}
    </p>
    <div class="mt-6 flex items-center text-sm font-semibold text-blue-600 dark:text-blue-400">
        Start Learning
        <svg class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
    </div>
</a>
