---
interface Props {
    title: string;
    description: string;
    href: string;
    icon?: string;
    color?: string;
}

const { title, description, href, icon = "📊", color = "blue" } = Astro.props;

const gradients = {
    blue: "from-blue-600/20 via-blue-900/10 to-transparent",
    purple: "from-purple-600/20 via-purple-900/10 to-transparent",
    green: "from-green-600/20 via-green-900/10 to-transparent",
    orange: "from-orange-600/20 via-orange-900/10 to-transparent",
};

const glows = {
    blue: "bg-blue-500/30",
    purple: "bg-purple-500/30",
    green: "bg-green-500/30",
    orange: "bg-orange-500/30",
};

const gradient = gradients[color as keyof typeof gradients] || gradients.blue;
const glow = glows[color as keyof typeof glows] || glows.blue;
---

<a
    href={href}
    class="group relative block aspect-square overflow-hidden rounded-[24px] bg-[#1e1e1f] border border-white/5 hover:border-white/20 transition-all duration-500 shadow-xl shadow-black/40"
>
    <!-- Background Texture Overlay -->
    <div
        class="absolute inset-0 opacity-[0.03] pointer-events-none z-10 bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
    >
    </div>

    <!-- Background Glow -->
    <div
        class={`absolute inset-0 bg-gradient-to-br ${gradient} opacity-40 group-hover:opacity-60 transition-opacity duration-500`}
    >
    </div>

    <!-- Center Visual (Icon or Image) -->
    <div
        class="absolute inset-0 flex items-center justify-center -translate-y-2 sm:-translate-y-4"
    >
        <div
            class={`absolute w-full h-full rounded-full ${glow} blur-[60px] opacity-10 group-hover:opacity-25 transition-opacity duration-700`}
        >
        </div>
        <div
            class="relative w-full h-full flex items-center justify-center p-6 sm:p-10 transition-all duration-700 ease-out group-hover:scale-105"
        >
            {
                icon.startsWith("/") ? (
                    <img
                        src={icon}
                        alt={title}
                        class="w-full h-full object-contain drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
                    />
                ) : (
                    <div class="text-6xl sm:text-7xl drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)] transform -rotate-12 transition-transform duration-500 group-hover:rotate-0">
                        {icon}
                    </div>
                )
            }
        </div>
    </div>

    <!-- Content Overlay -->
    <div
        class="absolute inset-x-0 bottom-0 p-4 sm:p-5 pt-16 sm:pt-24 bg-gradient-to-t from-[#131314] via-[#131314]/80 to-transparent z-20"
    >
        <div class="transition-transform duration-500 ease-out">
            <h3
                class="text-[12px] sm:text-[15px] font-semibold text-white mb-0.5 sm:mb-1 font-display tracking-tight leading-tight"
            >
                {title}
            </h3>
            <p
                class="text-neutral-400 text-[10px] sm:text-[12px] leading-tight sm:leading-relaxed opacity-0 group-hover:opacity-100 transition-all duration-500 delay-75 line-clamp-3 overflow-hidden"
            >
                {description}
            </p>
        </div>
    </div>

    <!-- Top Left Accent (Like Gemini Labs icon) -->
    <div
        class="absolute top-4 left-4 z-20 opacity-40 group-hover:opacity-100 transition-opacity"
    >
        <div
            class={`w-5 h-5 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center backdrop-blur-sm`}
        >
            <span class="text-[10px] grayscale brightness-200">✨</span>
        </div>
    </div>
</a>

<style>
    .font-display {
        font-family: "Outfit", sans-serif;
    }
</style>
