---
import { BookOpen } from "lucide-react";
import ThemeToggle from "../ThemeToggle.astro";
import FontSettings from "../docs/FontSettings";
import PencilRocketLogo from "../docs/PencilRocketLogo.astro";

const base = import.meta.env.BASE_URL;

const navLinks = [
    { label: "Courses", href: `${base}courses` },
    { label: "Docs", href: `${base}docs` },
    { label: "Blog", href: `${base}blog` },
];
---

<header
    class="sticky top-0 z-50 w-full border-b border-slate-200 dark:border-neutral-800 bg-white/90 dark:bg-[#1e1e1f]/95 backdrop-blur-md"
>
    <div class="max-w-8xl mx-auto px-4 lg:px-8">
        <div class="flex items-center h-[57px] gap-4">
            <!-- Logo -->
            <a
                href={base}
                class="flex items-center gap-2 font-bold text-slate-900 dark:text-white tracking-tight flex-shrink-0"
            >
                <div
                    class="w-7 h-7 bg-slate-100 dark:bg-neutral-900 rounded-lg flex items-center justify-center border border-slate-200 dark:border-neutral-800"
                >
                    <PencilRocketLogo size={18} />
                </div>
                <span>Kinetix</span>
                <span
                    class="text-[10px] font-semibold px-1.5 py-0.5 bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full border border-blue-100 dark:border-blue-500/20 tracking-widest uppercase"
                >
                    courses
                </span>
            </a>

            <!-- Spacer -->
            <div class="flex-1"></div>

            <!-- Nav Links (desktop) -->
            <nav class="hidden md:flex items-center gap-1">
                {
                    navLinks.map((link) => (
                        <a
                            href={link.href}
                            class="px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-neutral-400 hover:text-slate-900 dark:hover:text-neutral-100 hover:bg-slate-100 dark:hover:bg-neutral-800 rounded-lg transition-colors"
                        >
                            {link.label}
                        </a>
                    ))
                }
            </nav>

            <!-- Divider -->
            <div
                class="hidden md:block w-px h-5 bg-slate-200 dark:bg-neutral-700 mx-1"
            >
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-1">
                <div class="hidden lg:block">
                    <FontSettings client:load />
                </div>
                <ThemeToggle />
            </div>

            <!-- Mobile menu button -->
            <button
                id="course-menu-btn"
                class="md:hidden p-2 rounded-md text-slate-500 hover:bg-slate-100 dark:hover:bg-neutral-800 transition-colors z-[60]"
            >
                <svg
                    class="w-5 h-5 menu-icon"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
                <svg
                    class="w-5 h-5 close-icon hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Menu Overlay -->
<div
    id="course-mobile-menu"
    class="fixed inset-0 bg-white dark:bg-[#0e0e0f] z-[100] translate-x-full transition-transform duration-300 md:hidden"
>
    <!-- Header inside Menu for Close Button -->
    <div
        class="flex items-center justify-between h-[57px] px-4 border-b border-slate-100 dark:border-neutral-800"
    >
        <div
            class="flex items-center gap-2 font-bold text-slate-900 dark:text-white"
        >
            <PencilRocketLogo size={18} />
            <span>Kinetix</span>
        </div>
        <button
            id="course-mobile-close-btn"
            class="p-2 rounded-md text-slate-500 hover:bg-slate-100 dark:hover:bg-neutral-800 transition-colors"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <div class="flex flex-col h-full py-6 px-6 gap-2">
        {
            navLinks.map((link) => (
                <a
                    href={link.href}
                    class="px-4 py-4 text-lg font-medium text-slate-900 dark:text-white border-b border-slate-100 dark:border-neutral-800 flex items-center justify-between group"
                >
                    {link.label}
                    <svg
                        class="w-5 h-5 text-slate-400 group-hover:translate-x-1 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                        />
                    </svg>
                </a>
            ))
        }
        <div class="mt-8 flex items-center justify-between px-4">
            <span
                class="text-sm text-neutral-500 font-medium font-display tracking-widest uppercase"
                >Settings</span
            >
            <FontSettings client:load />
        </div>
    </div>
</div>

<script>
    const setupMenu = () => {
        const openBtn = document.getElementById("course-menu-btn");
        const closeBtn = document.getElementById("course-mobile-close-btn");
        const menu = document.getElementById("course-mobile-menu");

        if (!openBtn || !menu || !closeBtn) return;

        const toggleMenu = (open: boolean) => {
            if (open) {
                menu.classList.remove("translate-x-full");
                document.body.style.overflow = "hidden";
            } else {
                menu.classList.add("translate-x-full");
                document.body.style.overflow = "";
            }
        };

        openBtn.addEventListener("click", () => toggleMenu(true));
        closeBtn.addEventListener("click", () => toggleMenu(false));

        // Close menu on link click
        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => toggleMenu(false));
        });

        // Close on Escape key
        document.addEventListener("keydown", (e) => {
            if (
                e.key === "Escape" &&
                !menu.classList.contains("translate-x-full")
            ) {
                toggleMenu(false);
            }
        });
    };

    setupMenu();
    document.addEventListener("astro:after-swap", setupMenu);
</script>

<style>
    .font-display {
        font-family: "Outfit", sans-serif;
    }
</style>
