---
import { Menu, X } from "lucide-react";
import DocsSidebar from "../../components/docs/DocsSidebar.astro";
import DocsHeader from "../../components/docs/DocsHeader.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import FontSettings from "../../components/docs/FontSettings";
import DocsTableOfContents from "../../components/docs/DocsTableOfContents.astro";
import DocsPrevNext from "../../components/docs/DocsPrevNext.astro";
import { docsConfig } from "../../config/docs";
import PencilRocketLogo from "../../components/docs/PencilRocketLogo.astro";
import "../../styles/docs/docs-prose.css";

const { title, currentSlug, headings = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}favicon.svg`}
        />
        <meta name="generator" content={Astro.generator} />
        <title>
            {title ? `${title} - Kinetix Docs` : "Kinetix Documentation"}
        </title>

        <script is:inline>
            // Check for saved theme or system preference - copied from Layout.astro
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);

            // Apply Typography Settings immediately to prevent flickering
            const savedFont = localStorage.getItem("docs-font-family");
            const savedSize = localStorage.getItem("docs-font-size");
            if (savedFont) {
                document.documentElement.style.setProperty(
                    "--docs-font-family",
                    savedFont,
                );
            }
            if (savedSize) {
                document.documentElement.style.setProperty(
                    "--docs-font-size-base",
                    savedSize,
                );
            }
        </script>

        <!-- Fonts (Same as Layout.astro) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600;700&family=Kalam:wght@300;400;700&family=Merriweather:wght@300;400;700;900&family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
            integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
            crossorigin="anonymous"
        />
    </head>
    <body
        class="font-sans antialiased text-slate-900 bg-white dark:bg-neutral-950 dark:text-neutral-50 h-full flex flex-col"
    >
        <!-- Specialized Docs Header -->
        <DocsHeader />

        <div class="flex flex-1 max-w-8xl mx-auto w-full">
            <!-- Desktop Sidebar -->
            <aside
                class="hidden lg:block w-64 border-r border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-neutral-900/50 sticky top-[57px] h-[calc(100vh-57px)] overflow-y-auto py-8 pr-6 pl-4"
            >
                <div class="mb-6">
                    <h5
                        class="text-sm font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider mb-4"
                    >
                        Documentation
                    </h5>
                    <DocsSidebar currentSlug={currentSlug} />
                </div>
            </aside>

            <!-- Mobile Off-canvas Sidebar -->
            <div
                id="docs-mobile-menu"
                class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity lg:hidden"
            >
                <div
                    class="absolute left-0 top-0 bottom-0 w-3/4 max-w-sm bg-white dark:bg-neutral-900 shadow-2xl transform -translate-x-full transition-transform duration-300 flex flex-col"
                    id="docs-mobile-drawer"
                >
                    <!-- Header & Nav (Scrollable) -->
                    <div
                        class="flex-1 overflow-y-auto p-6 scrollbar-thin scrollbar-thumb-slate-200 dark:scrollbar-thumb-slate-700"
                    >
                        <div class="flex items-center justify-between mb-6">
                            <h2
                                class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2"
                            >
                                <div
                                    class="w-8 h-8 bg-slate-100 dark:bg-neutral-800 rounded-lg flex items-center justify-center border border-slate-200 dark:border-slate-700"
                                >
                                    <PencilRocketLogo size={20} />
                                </div>
                                Navigation
                            </h2>
                            <button
                                id="docs-menu-close"
                                class="p-2 rounded-md text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                            >
                                <X size={20} />
                            </button>
                        </div>
                        <DocsSidebar currentSlug={currentSlug} />
                    </div>

                    <!-- Bottom Controls (Pinned) -->
                    <div
                        class="p-4 border-t border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-neutral-900/80 backdrop-blur-md"
                    >
                        <div class="grid grid-cols-2 gap-3">
                            <div
                                class="flex flex-col gap-2 p-3 rounded-xl bg-white dark:bg-neutral-800 border border-slate-200 dark:border-slate-700 shadow-sm transition-transform hover:scale-[1.02]"
                            >
                                <span
                                    class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                                    >Appearance</span
                                >
                                <div class="flex items-center justify-between">
                                    <span
                                        class="text-sm font-medium text-slate-700 dark:text-slate-200"
                                        >Theme</span
                                    >
                                    <ThemeToggle />
                                </div>
                            </div>
                            <div
                                class="flex flex-col gap-2 p-3 rounded-xl bg-white dark:bg-neutral-800 border border-slate-200 dark:border-slate-700 shadow-sm transition-transform hover:scale-[1.02]"
                            >
                                <span
                                    class="text-xs font-semibold text-slate-400 uppercase tracking-wider"
                                    >Readability</span
                                >
                                <div class="flex items-center justify-between">
                                    <span
                                        class="text-xs font-medium text-slate-700 dark:text-slate-200 truncate mr-2"
                                        >Font</span
                                    >
                                    <FontSettings client:load align="top" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <main class="flex-1 w-full min-w-0 px-4 md:px-8 py-10 lg:pl-10">
                <div
                    class={`${docsConfig.ui.contentMaxWidth} mx-auto flex items-start gap-12`}
                >
                    <article
                        class="prose dark:prose-invert flex-1 min-w-0 max-w-none"
                    >
                        <slot />
                        {
                            docsConfig.ui.showPrevNextLinks && (
                                <DocsPrevNext currentSlug={currentSlug} />
                            )
                        }
                    </article>
                    {
                        docsConfig.ui.showTableOfContents && (
                            <DocsTableOfContents headings={headings} />
                        )
                    }
                </div>
            </main>
        </div>

        <script>
            // Mobile Menu Logic (Updated for Header Trigger and Left Drawer)
            const menuBtnHeader = document.getElementById(
                "docs-menu-btn-header",
            ); // From DocsHeader
            const closeBtn = document.getElementById("docs-menu-close");
            const mobileMenu = document.getElementById("docs-mobile-menu");
            const drawer = document.getElementById("docs-mobile-drawer");

            function openMenu() {
                mobileMenu?.classList.remove(
                    "opacity-0",
                    "pointer-events-none",
                );
                drawer?.classList.remove("-translate-x-full");
                document.body.style.overflow = "hidden";
            }

            function closeMenu() {
                mobileMenu?.classList.add("opacity-0", "pointer-events-none");
                drawer?.classList.add("-translate-x-full");
                document.body.style.overflow = "";
            }

            if (menuBtnHeader)
                menuBtnHeader.addEventListener("click", openMenu);
            if (closeBtn) closeBtn.addEventListener("click", closeMenu);

            // Close on outside click
            if (mobileMenu) {
                mobileMenu.addEventListener("click", (e) => {
                    if (e.target === mobileMenu) closeMenu();
                });
            }
        </script>
    </body>
</html>
