---
import { Menu, X, ChevronLeft } from "lucide-react";
import CourseSidebar from "../../components/courses/CourseSidebar.astro";
import DocsHeader from "../../components/docs/DocsHeader.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import FontSettings from "../../components/docs/FontSettings";
import DocsTableOfContents from "../../components/docs/DocsTableOfContents.astro";
import DocsPrevNext from "../../components/docs/DocsPrevNext.astro";
import { docsConfig } from "../../config/docs";
import PencilRocketLogo from "../../components/docs/PencilRocketLogo.astro";
import "../../styles/docs/docs-prose.css";

const { title, currentSlug, courseType, headings = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/svg+xml"
            href={`${import.meta.env.BASE_URL}favicon.svg`}
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title} - Kinetix Courses</title>

        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();
            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);
        </script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="font-sans antialiased text-slate-900 bg-white dark:bg-neutral-950 dark:text-neutral-50 h-full flex flex-col"
    >
        <DocsHeader />

        <div class="flex flex-1 max-w-8xl mx-auto w-full">
            <!-- Desktop Sidebar -->
            <aside
                class="hidden lg:block w-72 border-r border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-neutral-900/50 sticky top-[57px] h-[calc(100vh-57px)] overflow-y-auto py-8 pr-6 pl-6"
            >
                <div class="mb-8">
                    <a
                        href={`${import.meta.env.BASE_URL}courses`}
                        class="flex items-center gap-2 text-sm font-semibold text-blue-600 dark:text-blue-400 mb-6 hover:underline"
                    >
                        <ChevronLeft size={16} />
                        Back to Courses
                    </a>
                    <h5
                        class="text-xs font-bold text-slate-400 dark:text-neutral-500 uppercase tracking-[0.2em] mb-4"
                    >
                        Course Content
                    </h5>
                    <CourseSidebar
                        currentSlug={currentSlug}
                        courseType={courseType}
                    />
                </div>
            </aside>

            <!-- Main Content -->
            <main class="flex-1 w-full min-w-0 px-4 md:px-8 py-10 lg:pl-10">
                <div
                    class={`${docsConfig.ui.contentMaxWidth} mx-auto flex items-start gap-12`}
                >
                    <article
                        class="prose dark:prose-invert flex-1 min-w-0 max-w-none"
                    >
                        <slot />
                    </article>
                    {
                        docsConfig.ui.showTableOfContents &&
                            headings.length > 0 && (
                                <DocsTableOfContents headings={headings} />
                            )
                    }
                </div>
            </main>
        </div>
    </body>
</html>
